# Optional: Supabase. Without these, the app uses data/tools.json (committed seed data).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LLM for extraction + classification. "openrouter" (default) or "openai".
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=anthropic/claude-haiku-5.5

# Discovery search: OpenRouter web search plugin (Exa), uses OPENROUTER_API_KEY.
SEARCH_PROVIDER=openrouter

# Protects /admin and /api/admin/*
ADMIN_PASSWORD=

# P1: protects the scheduled refresh endpoint
CRON_SECRET=
